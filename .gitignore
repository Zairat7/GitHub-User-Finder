git init
echo "venv/\n__pycache__/\nfavorites.json" > .gitignore
import tkinter as tk
from tkinter import messagebox
import customtkinter as ctk
import requests
import json
import os

class GitHubUserFinder(ctk.CTk):
    def __init__(self):
        super().__init__()

        self.title("GitHub User Finder")
        self.geometry("400x550")
        self.favorites_file = "favorites.json"

        # UI Элементы
        self.label = ctk.CTkLabel(self, text="Введите логин GitHub:", font=("Arial", 16))
        self.label.pack(pady=10)

        self.entry = ctk.CTkEntry(self, width=250, placeholder_text="Octocat...")
        self.entry.pack(pady=5)

        self.search_btn = ctk.CTkButton(self, text="Поиск", command=self.search_user)
        self.search_btn.pack(pady=10)

        self.result_frame = ctk.CTkFrame(self)
        self.result_frame.pack(pady=20, fill="both", expand=True, padx=20)

        self.user_label = ctk.CTkLabel(self.result_frame, text="", font=("Arial", 14, "bold"))
        self.user_label.pack(pady=10)

        self.add_fav_btn = ctk.CTkButton(self.result_frame, text="В избранное", 
                                          state="disabled", command=self.add_to_favorites)
        self.add_fav_btn.pack(pady=5)

        self.current_user_data = None

    def search_user(self):
        username = self.entry.get().strip()
        
        # Проверка на пустое поле
        if not username:
            messagebox.showwarning("Ошибка", "Поле поиска не должно быть пустым!")
            return

        try:
            response = requests.get(f"https://github.com{username}")
            if response.status_code == 200:
                data = response.json()
                self.current_user_data = {
                    "login": data["login"],
                    "url": data["html_url"],
                    "name": data.get("name") or "Нет имени"
                }
                self.user_label.configure(text=f"Найдено: {data['login']}\n({self.current_user_data['name']})")
                self.add_fav_btn.configure(state="normal")
            else:
                self.user_label.configure(text="Пользователь не найден")
                self.add_fav_btn.configure(state="disabled")
        except Exception as e:
            messagebox.showerror("Ошибка сети", f"Не удалось подключиться: {e}")

    def add_to_favorites(self):
        if not self.current_user_data:
            return

        favorites = []
        if os.path.exists(self.favorites_file):
            with open(self.favorites_file, "r", encoding="utf-8") as f:
                favorites = json.load(f)

        # Проверка на дубликаты
        if any(u['login'] == self.current_user_data['login'] for u in favorites):
            messagebox.showinfo("Инфо", "Пользователь уже в избранном")
            return

        favorites.append(self.current_user_data)
        
        with open(self.favorites_file, "w", encoding="utf-8") as f:
            json.dump(favorites, f, indent=4, ensure_all_脫scii=False)
        
        messagebox.showinfo("Успех", f"{self.current_user_data['login']} добавлен в избранное!")

if __name__ == "__main__":
    app = GitHubUserFinder()
    app.mainloop()

